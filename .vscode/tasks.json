{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$esbuild",
      "label": "npm: compile"
    },
    {
      "type": "npm",
      "script": "watch:esbuild",
      "group": "build",
      "problemMatcher": "$esbuild-watch",
      "isBackground": true,
      "label": "npm: watch:esbuild"
    },
    {
      "type": "npm",
      "script": "watch",
      "dependsOn": [
        "npm: watch:esbuild"
      ],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "label": "watch"
    }
  ]
}
