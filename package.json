{
  "name": "repopilot",
  "displayName": "RepoPilot",
  "publisher": "RepoPilot",
  "description": "Autonomous VS Code extension for repository health, semantic commits, and intelligent background monitoring based on Diagram.png.",
  "version": "0.1.0",
  "icon": "Diagram.png",
  "diagram": "Diagram.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repopilot.draftCommit",
        "title": "Draft Semantic Commit",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.turboMode",
        "title": "Run Turbo Mode",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.sprintLogistics",
        "title": "Run Sprint Logistics",
        "category": "RepoPilot"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.1"
  }
}
