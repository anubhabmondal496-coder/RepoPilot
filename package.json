{
  "name": "repopilot",
  "displayName": "RepoPilot",
  "publisher": "RepoPilot",
  "description": "Autonomous VS Code extension for repository health, semantic commits, and intelligent background monitoring based on Diagram.png.",
  "version": "0.1.0",
  "icon": "RepoPilot-icon-128x128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/anubhabmondal496-coder/RepoPilot.git"
  },
  "bugs": {
    "url": "https://github.com/anubhabmondal496-coder/RepoPilot/issues"
  },
  "homepage": "https://github.com/anubhabmondal496-coder/RepoPilot#readme",
  "license": "MIT",
  "keywords": [
    "autonomous",
    "copilot",
    "hackathon",
    "gemini",
    "git",
    "audit",
    "security",
    "api-contracts"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "repopilot": "./bin/repopilot.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "repopilot.draftCommit",
        "title": "Draft Semantic Commit",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.setApiKey",
        "title": "Set Gemini API Key",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.setGroqApiKey",
        "title": "Set Groq API Key",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.enableTurboMode",
        "title": "Enable Turbo Mode",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.enablePreviewMode",
        "title": "Enable Preview Mode",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.generateQnA",
        "title": "Generate Judge Q&A Guide",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.generatePitch",
        "title": "Generate 3-5 Min Pitch Script",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.checkStatus",
        "title": "Check API Contracts & Secret Safety",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.checkHealth",
        "title": "Run Security & Vulnerability Audit",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.organizeWorkspace",
        "title": "Organize File Structure",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.automateSubmit",
        "title": "Generate & Verify Portal Submission",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.interactiveJudge",
        "title": "Start Interactive Judge Simulator",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.fixDeps",
        "title": "Fix Missing Dependencies",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.turboMode",
        "title": "Run Turbo Mode",
        "category": "RepoPilot"
      },
      {
        "command": "repopilot.sprintLogistics",
        "title": "Run Sprint Logistics",
        "category": "RepoPilot"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@octokit/rest": "^22.0.1",
    "zod": "^4.6.7"
  }
}
